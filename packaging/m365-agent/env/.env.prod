# Committed: the single source of the production agent's Microsoft IDs.
# These are public identifiers, not credentials; every installer downloads the
# package that contains them. Agents Toolkit writes them here during the
# approved production provision; commit the result. The toolkit keeps secrets
# in env/.env.prod.user, which stays ignored. validate-m365-agent.sh rejects
# any key not listed here.
TEAMSFX_ENV=prod
APP_NAME_SUFFIX=
APP_VERSION=1.0.0
AGENT_SCOPE=tenant

# Written by teamsApp/create during the approved production provision.
TEAMS_APP_ID=

# Written by dcr/register during the approved production provision. This is a
# Microsoft auth-configuration ID, not an OAuth client ID or client secret.
GETWHYS_DCR_AUTH_ID=

# Written by copilotAgent/publish.
M365_TITLE_ID=
M365_APP_ID=
SHARE_LINK=
